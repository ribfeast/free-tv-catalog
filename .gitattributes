# Keep line endings LF in the repository regardless of the OS committing.
#
# This matters: check-streams.sh committed with CRLF fails on macOS/Linux with a
# confusing "bad interpreter" error, because the shebang line ends up as
# "#!/usr/bin/env bash\r".
* text=auto eol=lf

*.sh  text eol=lf
*.json text eol=lf
*.md  text eol=lf
